# Only these two website blocks; merge into /opt/ion-edge/Caddyfile.
# Never replace the entire edge configuration with this fragment.
soft.infa-ion.ru {
    encode zstd gzip
    root * /srv/ioninf-soft
    file_server
    @versioned path_regexp versioned \.[a-f0-9]{12}\.(css|js|json|svg|webp|jpg|woff2|txt)$
    @html path / /index.html /release-manifest.json
    header @html Cache-Control "no-cache"
    header @versioned Cache-Control "public, max-age=31536000, immutable"
    header {
        -Server
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        Strict-Transport-Security "max-age=31536000"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

soft.ioninf.ru {
    redir https://soft.infa-ion.ru{uri} 308
}
